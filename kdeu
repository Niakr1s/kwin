#!/usr/bin/env bash

function update() {
  (
    local KWIN_DIR="$HOME/.local/share/kwin"

    cd "$KWIN_DIR" || {
      echo "couldn't cd to $KWIN_DIR"
      echo "you should clone it first"
      echo "git clone git@github.com:Niakr1s/kwin.git $KWIN_DIR"
      return 1
    }
    echo "pwd: $PWD"

    local BEFORE
    BEFORE="$(./sera -l)"
    echo "BEFORE: $BEFORE"

    ./sera -u

    local AFTER
    AFTER="$(./sera -l)"

    if [[ "$BEFORE" == "$AFTER" ]]; then
      if [[ -z "$KDEU_SKIP_BEFORE_AFTER_CHECK" ]]; then
        echo "There was no updates"
        return
      fi
    else
      echo "Installed update."
      echo "AFTER: $AFTER"
    fi

    git status || {
      echo "not in git repo, exiting..."
      return
    }

    git add . || return 1

    git commit -m "update" -m "BEFORE: $BEFORE" -m "AFTER: $AFTER" || {
      echo "git: coudn't commit an update"
      return 1
    }
    echo "git: commited an update"

    git push || {
      echo "couldn't push changes, are you own this git repo?"
      return 1
    }
    echo "git: pushed changes"
  )
}

update
